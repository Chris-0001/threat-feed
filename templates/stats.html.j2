{% extends "base.html.j2" %}
{% block content %}
<h1>{{ heading }}</h1>
<p class="intro">{{ intro }}</p>
<div class="stats-chart">
    <img src="assets/stats.svg" alt="Statistics Graphs">
</div>
<div class="dashboard-grid">
  <div><strong>{{ stats.configured_feeds }}</strong><span>configured feeds</span></div>
  <div><strong>{{ stats.open_jobs }}</strong><span>currently open jobs</span></div>
  <div><strong>{{ stats.archive_items }}</strong><span>valid archive items</span></div>
  <div><strong>{{ stats.archive_months }}</strong><span>archive months</span></div>
  <div><strong>{{ stats.errors_30d }}</strong><span>errors in last 30 days</span></div>
</div>
<section class="architecture-diagram">
  <h2>System Architecture</h2>
  <div class="architecture-flow" aria-label="Threat feed system architecture">
    <div class="architecture-node">Hourly schedule or manual run</div>
    <div class="architecture-arrow" aria-hidden="true">↓</div>
    <div class="architecture-group">
      <strong>Collect job</strong>
      <div class="architecture-node">Fetch HTTPS feeds with size, timeout, and redirect limits</div>
      <div class="architecture-arrow" aria-hidden="true">↓</div>
      <div class="architecture-node">Parse RSS, KEV, watch pages, Workable, Diavgeia, and static sources</div>
      <div class="architecture-arrow" aria-hidden="true">↓</div>
      <div class="architecture-node">Sanitize text, validate allowlists, filter, and deduplicate</div>
      <div class="architecture-arrow" aria-hidden="true">↓</div>
      <div class="architecture-node">Commit validated data to the repository</div>
    </div>
    <div class="architecture-arrow" aria-hidden="true">↓</div>
    <div class="architecture-group">
      <strong>Build job</strong>
      <div class="architecture-node">Validate archive data and render HTML, RSS, and statistics SVG</div>
    </div>
    <div class="architecture-arrow" aria-hidden="true">↓</div>
    <div class="architecture-node">Upload Pages artifact and deploy to GitHub Pages</div>
    <div class="architecture-arrow" aria-hidden="true">↓</div>
    <div class="architecture-node">Reader, browser, or RSS application</div>
  </div>
</section>
{% endblock %}